# Pantallas que todavía usan datos de ejemplo o endpoints propuestos.
# En desarrollo quedan prendidas salvo que se pongan en false;
# en producción quedan apagadas salvo que se pongan en true.
VITE_MOSTRAR_REPLAY=true
VITE_MOSTRAR_SUSCRIPCION=true
VITE_MOSTRAR_INSTITUCIONAL=true
VITE_MOSTRAR_TENDENCIA=true

# URL del bot de Telegram (por ejemplo https://t.me/YakuBot).
# Sin ella, la pantalla de suscripción avisa que todavía no está disponible.
# VITE_TELEGRAM_BOT_URL=

# URL base de la API si no es el mismo origen (en dev, el proxy de Vite ya redirige /api).
# VITE_API_URL=
