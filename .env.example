# Copiar a backend/.env y completar. No subir .env al repo.

# Puerto del backend
PORT=3001

# Secreto para POST /api/jobs/run (cron externo). Sin este valor el endpoint queda deshabilitado.
JOB_SECRET=

# Origen permitido para CORS (URL del frontend desplegado). Vacío = cualquiera.
FRONTEND_ORIGIN=

# Clave compartida de la vista institucional (POST /api/admin/login). Sin este valor el panel queda deshabilitado.
ADMIN_PASSWORD=

# Token del bot de Telegram (se pide a @BotFather). Sin este valor el bot queda apagado y no salen avisos.
TELEGRAM_BOT_TOKEN=

# URL pública del backend. Con valor, el bot usa webhook; vacío, usa polling (para desarrollo local).
# En Render no hace falta: se toma RENDER_EXTERNAL_URL.
PUBLIC_URL=

# Pendiente (todavía no se usa):
# DATABASE_URL=            # Postgres de Neon, para Prisma
